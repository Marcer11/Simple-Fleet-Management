{
  "id": "/",
  "name": "Simple Fleet Manager",
  "short_name": "Fleet",
  "description": "Evidence vozidel, tankování, servisu, pneumatik a výdajů",
  "lang": "cs",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f3f5f8",
  "theme_color": "#1e293b",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Přidat tankování", "short_name": "Tankování", "url": "/fuel-records/add", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Zapsat servis", "short_name": "Servis", "url": "/services/add", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Přidat výdaj", "short_name": "Výdaj", "url": "/expenses/add", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Vozidla", "short_name": "Vozidla", "url": "/vehicles", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "/static/screenshots/narrow-vehicle.png", "sizes": "540x1170", "type": "image/png", "form_factor": "narrow", "label": "Přehled vozidla" },
    { "src": "/static/screenshots/narrow-stats.png", "sizes": "540x1170", "type": "image/png", "form_factor": "narrow", "label": "Statistiky" },
    { "src": "/static/screenshots/wide-vehicle.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Přehled vozidla" }
  ]
}
